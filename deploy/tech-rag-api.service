[Unit]
Description=Tech Finance API (FastAPI)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=techrag
Group=techrag
WorkingDirectory=/opt/tech-rag/app
EnvironmentFile=/etc/tech-rag/env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tech-rag/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tech-rag/app/data/chroma
MemoryMax=1G

[Install]
WantedBy=multi-user.target
